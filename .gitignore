# dependencies
/node_modules
# vitest creates a .vite cache under node_modules when invoked from a
# subdirectory; catch those nested strays so they can't leak into commits.
**/node_modules
/.pnp
.pnp.js

# testing
/coverage
coverage-*.json
coverage-*.txt

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA (generated by @serwist/next)
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map
.claude/scheduled_tasks.lock

# Local CLI binaries (never commit — the supabase CLI is ~90MB)
*.exe
supabase.exe
.claude/worktrees/

